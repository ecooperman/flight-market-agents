[Unit]
Description=Flight Market Agents
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/apps/flight-market-agents
ExecStart=/opt/apps/flight-market-agents/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8050
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
