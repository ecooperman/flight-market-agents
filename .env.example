# Copy this file to .env and fill in your own values.
# Free/paid self-service key: https://serpapi.com (250 free searches/month,
# no card required; $25/mo for 1,000 if you outgrow that)

SERPAPI_KEY=your_serpapi_key_here

# true  -> runs entirely on simulated data, no API keys needed, safe to demo instantly
# false -> calls the real SerpApi Google Flights engine with the key above
USE_MOCK_DATA=true

# Only needed for the "AI agent" mode (real tool-use loop via Claude).
# Get a key at https://console.anthropic.com -- this mode makes real,
# billed API calls even while USE_MOCK_DATA=true (it still uses mock
# market data by default, but the reasoning calls to Claude are real).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-sonnet-5
