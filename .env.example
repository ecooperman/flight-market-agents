# Copy this file to .env and fill in your own values.
# Free self-service keys: https://developers.amadeus.com/register

AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_BASE_URL=https://test.api.amadeus.com

# true  -> runs entirely on simulated data, no API keys needed, safe to demo instantly
# false -> calls the real Amadeus Flight Offers Search API with the credentials above
USE_MOCK_DATA=true

# Only needed for the "AI agent" mode (real tool-use loop via Claude).
# Get a key at https://console.anthropic.com -- this mode makes real,
# billed API calls even while USE_MOCK_DATA=true (it still uses mock
# market data by default, but the reasoning calls to Claude are real).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-sonnet-5
